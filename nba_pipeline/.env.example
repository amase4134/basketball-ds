# Weekly win-report email delivery.
# Copy to `.env` (gitignored) and fill in SMTP_APP_PASSWORD.
#
# Gmail rejects your normal account password over SMTP. Create an App Password:
#   1. Enable 2-Step Verification at https://myaccount.google.com/security
#   2. Visit https://myaccount.google.com/apppasswords
#   3. Generate a password for "Mail" and paste the 16 characters below
#      (spaces are stripped automatically).
#
# With SMTP_APP_PASSWORD unset the report is handed to macOS Mail.app instead,
# using whichever account is already signed in on this Mac.

NBA_REPORT_TO=amase4134@gmail.com

SMTP_HOST=smtp.gmail.com
# 465 for implicit TLS, 587 for STARTTLS.
SMTP_PORT=465
SMTP_USER=amase4134@gmail.com
SMTP_APP_PASSWORD=
