<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.basketballds.nba-weekly-report</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/Data-700GB/Basketball DS/nba_pipeline/scripts/weekly_win_report.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/Data-700GB/Basketball DS/nba_pipeline</string>

    <!-- Fridays at 8:30am, half an hour after the daily refresh starts. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Volumes/Data-700GB/Basketball DS/nba_pipeline/logs/launchd.weekly.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/Data-700GB/Basketball DS/nba_pipeline/logs/launchd.weekly.err.log</string>
</dict>
</plist>
